@{
    ViewData["Title"] = "Chat";
}

<div>
    <h3>Ви увійшли як: <b>@User.Identity.Name</b></h3>
    <form method="post" asp-controller="Account" asp-action="Logout">
        <input type="submit" value="Exit" />
    </form>
</div>
<hr />

<div style="display:flex;">
    <div style="width: 70%;">
        <p>
            User:<br />
            <input type="text" id="receiver" placeholder="Введіть email або виберіть зі списку" />
        </p>
        <p>
            Message:<br />
            <input type="text" id="message" />
            <input type="button" id="sendBtn" value="Надіслати" disabled="disabled" />
        </p>

        <div id="chatroom"></div>
    </div>

    <div style="width: 30%;">
        <h4>Online:</h4>
        <ul id="usersList"></ul>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    const hubConnection = new signalR.HubConnectionBuilder()
        .withUrl("/chat")
        .build();

    hubConnection.on("Receive", function (user, message, id) {
        const elem = document.createElement("p");
        elem.id = id;

        const userNameElem = document.createElement("b");
        userNameElem.textContent = `${user}: `;
        elem.appendChild(userNameElem);

        elem.appendChild(document.createTextNode(message + " "));

        const delBtn = document.createElement("button");
        delBtn.textContent = "x";
        delBtn.onclick = function () {
            hubConnection.invoke("Delete", id);
        };
        elem.appendChild(delBtn);

        const firstElem = document.getElementById("chatroom").firstChild;
        document.getElementById("chatroom").insertBefore(elem, firstElem);
    });

    hubConnection.on("Notify", function (message) {
        const elem = document.createElement("p");
        elem.style.color = "gray";
        elem.textContent = message;

        const firstElem = document.getElementById("chatroom").firstChild;
        document.getElementById("chatroom").insertBefore(elem, firstElem);
    });

    hubConnection.on("DeleteMessage", function (id) {
        const msgElem = document.getElementById(id);
        if (msgElem) {
            msgElem.remove();
        }
    });

    hubConnection.on("UpdateUsers", function (users) {
        const list = document.getElementById("usersList");
        list.innerHTML = "";
        users.forEach(function (u) {
            const li = document.createElement("li");
            li.textContent = u;
            li.style.cursor = "pointer";
            li.onclick = function () {
                document.getElementById("receiver").value = u;
            };
            list.appendChild(li);
        });
    });

    document.getElementById("sendBtn").addEventListener("click", function () {
        const message = document.getElementById("message").value;
        const receiver = document.getElementById("receiver").value;
        const id = "msg" + Date.now(); 

        if (receiver.trim() !== "") {
            hubConnection.invoke("SendPrivate", message, receiver, id)
                .catch(err => console.error(err.toString()));
        } else {
            hubConnection.invoke("Send", message, id)
                .catch(err => console.error(err.toString()));
        }

        document.getElementById("message").value = "";
    });

    hubConnection.start()
        .then(function () {
            document.getElementById("sendBtn").disabled = false;
        })
        .catch(function (err) {
            return console.error(err.toString());
        });
</script>